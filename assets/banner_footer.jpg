<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="200" viewBox="0 0 1200 200">
  <defs>
    <linearGradient id="footerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2c3e50;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#34495e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a252f;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="200" fill="url(#footerGrad)"/>
  <text x="600" y="100" font-family="Arial, sans-serif" font-size="36" font-weight="bold" text-anchor="middle" fill="#ffffff" opacity="0.8">Footer Banner</text>
  <rect x="50" y="150" width="80" height="30" fill="#00d4aa" opacity="0.4" rx="5"/>
  <rect x="1070" y="20" width="80" height="30" fill="#007bff" opacity="0.4" rx="5"/>
</svg>